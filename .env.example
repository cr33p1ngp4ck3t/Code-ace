# Keep this key on your machine. Never put it in extension code.
GROQ_API_KEY=
GROQ_TEXT_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=qwen/qwen3.6-27b
GROQ_AUDIO_MODEL=whisper-large-v3-turbo
# Per server process. Provider limits still apply. Restart resets these counters.
MAX_AI_CHECKS_PER_DAY=80
MAX_AI_CHECKS_PER_MINUTE=4
MAX_AI_TOKENS_PER_DAY=100000
# Optional: restrict the local backend to your installed extension's ID.
ALLOWED_EXTENSION_ID=
